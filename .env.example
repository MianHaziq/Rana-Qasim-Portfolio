# Optional: set these to your EmailJS (https://www.emailjs.com) service,
# template, and public key to have the contact form deliver real emails with
# zero backend code. Takes priority over NEXT_PUBLIC_FORMSPREE_ID if set.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_n4u8imh
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_zldel85
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=-TKz3zJKvsQcSdAXW


# Optional: set this to a Formspree form ID (https://formspree.io) to have the
# contact form deliver real emails with zero backend code. Leave unset and the
# form falls back to opening a pre-filled mailto: link instead.
NEXT_PUBLIC_FORMSPREE_ID=
